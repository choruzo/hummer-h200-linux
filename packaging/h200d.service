[Unit]
Description=NOX Hummer H-200 LCD feeder
Documentation=file:/usr/local/share/doc/h200d/PROTOCOL.md
After=multi-user.target

[Service]
# h200d waits for the display on its own and reconnects after an unplug, so it
# is fine to start before the device exists. Restart= only covers a real crash.
ExecStart=/usr/local/bin/h200d --metrics cpu-temp,gpu-temp,fan
Restart=on-failure
RestartSec=5

# Unprivileged: the udev rule puts the hidraw node in the h200 group.
User=h200
Group=h200

# It only ever reads /sys and /proc and writes to one character device.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
DeviceAllow=char-hidraw rw

[Install]
WantedBy=multi-user.target
